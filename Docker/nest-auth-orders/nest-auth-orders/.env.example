# ---- Copy to .env and fill in real values. NEVER commit .env ----

# App
PORT=3000

# MongoDB container (used by docker-compose)
MONGO_INITDB_ROOT_USERNAME=root
MONGO_INITDB_ROOT_PASSWORD=change_me_db_password   # avoid special chars (@ : / ?) or URL-encode them
MONGO_DB_NAME=nest_shop

# JWT
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=1d

# First admin, created automatically on startup if it does not exist
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# Only needed when running WITHOUT docker-compose (npm run start:dev).
# Inside docker-compose, MONGO_URI is assembled automatically and points to the "mongo" service.
# MONGO_URI=mongodb://root:change_me_db_password@localhost:27017/nest_shop?authSource=admin
