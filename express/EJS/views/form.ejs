<%- include("nav") -%>
<div class="container my-auto py-5">
  <div class="row mb-4">
    <div class="col text-center h3">Form Submit Using EJS!</div>
  </div>

  <div class="row justify-content-center">
    <div class="col-md-6 bg-white p-4 shadow-sm rounded">
      <form action="/submit" method="POST">
        <div class="mb-3">
          <label for="myName" class="form-label fw-bold">Enter Name:</label>
          <input
            type="text"
            class="form-control"
            id="myName"
            name="myName"
            required
          />
        </div>
        <button type="submit" class="btn btn-dark w-100 py-2">Submit</button>
      </form>
    </div>
  </div>
  <div class="row">
    <div class="col text-center mt-2"><%=message_%></div>
  </div>
</div>
<%- include("footer") -%>
