<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%=title%></title>
    <style>
        table{
            border: 4px solid  rgb(17, 167, 217);
            padding: 10px;
            width: 400px;
            height: 100px;
            background: #b7dcf4;
            font-family: sans-serif;
            font-weight: 500;
            color: rgb(6, 183, 242);
        }
    </style>
  </head>
  <body>
    <div>
          <% if (h1) { %> 
          <h1 style="color: rgb(100, 169, 169);"><%=h1%></h1>
        <% } else{ %>
            <h1>Hello !</h1>
        <% } %>
    <p>
      Lorem ipsum dolor sit abet consenter piscina edit. Reprehended, possums.
    </p>
    <!-- <%# let item = ["apple","banana","Mango"] %>  -->
    <ul>
        <% item.forEach(element => {%>
            <li><%=element%></li>
            <%})  %>
    </ul>
    <table >
        <% items.forEach(element => {%>
        <tr>
            <td><%=element.name%></td>
            <td><%=element.color%></td>
            <td><%=element.price%></td>
        </tr>
            <%})  %>
    </table>
    </div>
<div>
<img src="/images/img.jpg" alt="Description of image"></div>

  </body>
</html>
