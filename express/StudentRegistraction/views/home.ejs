<%- include('partials/header.ejs') %>

<!-- Content -->
<main class="py-5 bg-light min-vh-100">
  <div class="container">

    <div class="row">
      <div class="col-12">

        <!-- Main Card -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

          <!-- Card Header -->
          <div class="card-header bg-white border-0 p-4">
            <div class="d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3">

              <div>
                <h2 class="mb-1 fw-bold text-dark">
                  <i class="fa fa-address-book text-success me-2"></i>
                  All Contacts
                </h2>
                <p class="text-muted mb-0">
                  Manage all your contacts from here
                </p>
              </div>

              <a href="/add-contact" class="btn btn-success px-4 py-2 rounded-3 shadow-sm">
                <i class="fa fa-plus-circle me-1"></i>
                Add New
              </a>

            </div>
          </div>

          <!-- Card Body -->
          <div class="card-body p-4">

            <!-- Responsive Table -->
            <div class="table-responsive">

              <table class="table table-hover align-middle mb-0">

                <thead class="table-light">
                  <tr>
                    <th scope="col" class="py-3">#</th>
                    <th scope="col" class="py-3">First Name</th>
                    <th scope="col" class="py-3">Last Name</th>
                    <th scope="col" class="py-3">Email</th>
                    <th scope="col" class="py-3">Phone</th>
                    <th scope="col" class="py-3 text-center">Actions</th>
                  </tr>
                </thead>

                <tbody>

                  <% allStudent.forEach((element,index) => { %>

                    <tr>

                      <td class="fw-semibold text-muted">
                        <%= index + 1 %>
                      </td>

                      <td class="fw-semibold">
                        <%= element.first_name %>
                      </td>

                      <td>
                        <%= element.last_name %>
                      </td>

                      <td>
                        <span class="text-muted">
                          <i class="fa fa-envelope me-1"></i>
                          <%= element.email %>
                        </span>
                      </td>

                      <td>
                        <span class="text-muted">
                          <i class="fa fa-phone me-1"></i>
                          <%= element.phone %>
                        </span>
                      </td>

                      <td class="text-center">

                        <!-- View -->
                        <a 
                          href="/show-contact/<%= element._id %>" 
                          class="btn btn-sm btn-outline-info rounded-circle"
                          title="Show"
                        >
                          <i class="fa fa-eye"></i>
                        </a>

                        <!-- Edit -->
                        <a 
                          href="/update-contact/<%= element._id %>" 
                          class="btn btn-sm btn-outline-secondary rounded-circle"
                          title="Edit"
                        >
                          <i class="fa fa-edit"></i>
                        </a>

                        <!-- Delete -->
                        <form 
                          action="/delete-contact/<%= element._id %>?_method=DELETE" 
                          method="POST" 
                          class="d-inline"
                        >
                          <button 
                            type="submit" 
                            class="btn btn-sm btn-outline-danger rounded-circle"
                            title="Delete"
                          >
                            <i class="fa fa-times"></i>
                          </button>
                        </form>

                      </td>

                    </tr>

                  <% }) %>

                </tbody>

              </table>

            </div>

            <!-- Pagination -->
            <nav class="mt-4">
              <ul class="pagination justify-content-center mb-0">

                <li class="page-item disabled">
                  <a class="page-link" href="#">
                    <i class="fa fa-angle-left me-1"></i>
                    Previous
                  </a>
                </li>

                <li class="page-item active">
                  <a class="page-link" href="#">1</a>
                </li>

                <li class="page-item">
                  <a class="page-link" href="#">
                    Next
                    <i class="fa fa-angle-right ms-1"></i>
                  </a>
                </li>

              </ul>
            </nav>

          </div>

        </div>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer.ejs') %>