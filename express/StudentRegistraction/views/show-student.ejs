<%- include('partials/header.ejs') %>

<!-- Content -->
<main class="py-5 bg-light min-vh-100">
  <div class="container">

    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <!-- Card -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

          <!-- Card Header -->
          <div class="card-header bg-primary text-white border-0 p-4">
            <h3 class="mb-1 fw-bold">
              <i class="fa fa-user-circle me-2"></i>
              Contact Details
            </h3>

            <p class="mb-0 opacity-75">
              View complete contact information
            </p>
          </div>

          <!-- Card Body -->
          <div class="card-body p-4 p-md-5">

            <!-- First Name -->
            <div class="row align-items-center mb-4">
              <div class="col-md-4">
                <label class="fw-semibold text-dark">
                  <i class="fa fa-user text-primary me-2"></i>
                  First Name
                </label>
              </div>

              <div class="col-md-8">
                <div class="bg-light rounded-3 px-3 py-2">
                  <span class="text-muted">
                    <%= showSingleStudent.first_name %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Last Name -->
            <div class="row align-items-center mb-4">
              <div class="col-md-4">
                <label class="fw-semibold text-dark">
                  <i class="fa fa-user text-primary me-2"></i>
                  Last Name
                </label>
              </div>

              <div class="col-md-8">
                <div class="bg-light rounded-3 px-3 py-2">
                  <span class="text-muted">
                    <%= showSingleStudent.last_name %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Email -->
            <div class="row align-items-center mb-4">
              <div class="col-md-4">
                <label class="fw-semibold text-dark">
                  <i class="fa fa-envelope text-primary me-2"></i>
                  Email
                </label>
              </div>

              <div class="col-md-8">
                <div class="bg-light rounded-3 px-3 py-2">
                  <span class="text-muted">
                    <%= showSingleStudent.email %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Phone -->
            <div class="row align-items-center mb-4">
              <div class="col-md-4">
                <label class="fw-semibold text-dark">
                  <i class="fa fa-phone text-primary me-2"></i>
                  Phone
                </label>
              </div>

              <div class="col-md-8">
                <div class="bg-light rounded-3 px-3 py-2">
                  <span class="text-muted">
                    <%= showSingleStudent.phone %>
                  </span>
                </div>
              </div>
            </div>

            <!-- Address -->
            <div class="row align-items-start mb-4">
              <div class="col-md-4">
                <label class="fw-semibold text-dark">
                  <i class="fa fa-map-marker text-primary me-2"></i>
                  Address
                </label>
              </div>

              <div class="col-md-8">
                <div class="bg-light rounded-3 px-3 py-2">
                  <span class="text-muted">
                    <%= showSingleStudent.address %>
                  </span>
                </div>
              </div>
            </div>

          </div>

          <!-- Card Footer -->
          <div class="card-footer bg-white border-top p-4">
            <div class="d-flex flex-wrap justify-content-end gap-2">

              <!-- Edit -->
              <a
                href="/update-contact/<%= showSingleStudent._id %>"
                class="btn btn-primary px-4"
              >
                <i class="fa fa-edit me-1"></i>
                Edit
              </a>

              <!-- Delete -->
              <form
                action="/delete-contact/<%= showSingleStudent._id %>?_method=DELETE"
                method="POST"
                class="d-inline"
              >
                <button
                  type="submit"
                  class="btn btn-outline-danger px-4"
                  title="Delete"
                >
                  <i class="fa fa-trash me-1"></i>
                  Delete
                </button>
              </form>

              <!-- Cancel -->
              <a
                href="/"
                class="btn btn-outline-secondary px-4"
              >
                <i class="fa fa-arrow-left me-1"></i>
                Back
              </a>

            </div>
          </div>

        </div>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer.ejs') %>