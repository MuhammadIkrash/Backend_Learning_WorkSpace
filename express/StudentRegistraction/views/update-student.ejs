<%- include('partials/header.ejs') %>

<!-- Content -->
<main class="py-5 bg-light min-vh-100">
  <div class="container">

    <div class="row justify-content-center">
      <div class="col-lg-8 col-md-10">

        <!-- Card -->
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

          <!-- Card Header -->
          <div class="card-header bg-primary text-white border-0 p-4">
            <h3 class="mb-1 fw-bold">
              <i class="fa fa-edit me-2"></i>
              Update Contact
            </h3>

            <p class="mb-0 opacity-75">
              Update the contact information below
            </p>
          </div>

          <!-- Form -->
          <form 
            action="/update-contact/<%= updateSingleStudent._id %>?_method=PUT" 
            method="post"
          >

            <div class="card-body p-4 p-md-5">

              <!-- First Name -->
              <div class="mb-4">
                <label for="first_name" class="form-label fw-semibold">
                  First Name
                </label>

                <div class="input-group">
                  <span class="input-group-text bg-light">
                    <i class="fa fa-user text-primary"></i>
                  </span>

                  <input
                    type="text"
                    value="<%= updateSingleStudent.first_name %>"
                    name="first_name"
                    id="first_name"
                    class="form-control"
                    placeholder="Enter first name"
                    required
                  >
                </div>
              </div>

              <!-- Last Name -->
              <div class="mb-4">
                <label for="last_name" class="form-label fw-semibold">
                  Last Name
                </label>

                <div class="input-group">
                  <span class="input-group-text bg-light">
                    <i class="fa fa-user text-primary"></i>
                  </span>

                  <input
                    type="text"
                    value="<%= updateSingleStudent.last_name %>"
                    name="last_name"
                    id="last_name"
                    class="form-control"
                    placeholder="Enter last name"
                    required
                  >
                </div>
              </div>

              <!-- Email -->
              <div class="mb-4">
                <label for="email" class="form-label fw-semibold">
                  Email
                </label>

                <div class="input-group">
                  <span class="input-group-text bg-light">
                    <i class="fa fa-envelope text-primary"></i>
                  </span>

                  <input
                    type="email"
                    value="<%= updateSingleStudent.email %>"
                    name="email"
                    id="email"
                    class="form-control"
                    placeholder="example@gmail.com"
                    required
                  >
                </div>
              </div>

              <!-- Phone -->
              <div class="mb-4">
                <label for="phone" class="form-label fw-semibold">
                  Phone
                </label>

                <div class="input-group">
                  <span class="input-group-text bg-light">
                    <i class="fa fa-phone text-primary"></i>
                  </span>

                  <input
                    type="tel"
                    value="<%= updateSingleStudent.phone %>"
                    name="phone"
                    id="phone"
                    class="form-control"
                    placeholder="03XX-XXXXXXX"
                    required
                  >
                </div>
              </div>

              <!-- Address -->
              <div class="mb-4">
                <label for="address" class="form-label fw-semibold">
                  Address
                </label>

                <div class="input-group">
                  <span class="input-group-text bg-light align-items-start pt-2">
                    <i class="fa fa-map-marker text-primary"></i>
                  </span>

                  <textarea
                    name="address"
                    id="address"
                    rows="4"
                    class="form-control"
                    placeholder="Enter complete address"
                    required
                  ><%= updateSingleStudent.address %></textarea>
                </div>
              </div>

            </div>

            <!-- Footer -->
            <div class="card-footer bg-white border-top p-4">
              <div class="d-flex justify-content-end gap-2">

                <a
                  href="/"
                  class="btn btn-outline-secondary px-4"
                >
                  <i class="fa fa-times me-1"></i>
                  Cancel
                </a>

                <button
                  type="submit"
                  class="btn btn-primary px-4"
                >
                  <i class="fa fa-save me-1"></i>
                  Update Contact
                </button>

              </div>
            </div>

          </form>

        </div>

      </div>
    </div>

  </div>
</main>

<%- include('partials/footer.ejs') %>